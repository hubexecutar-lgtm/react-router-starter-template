{
	"extends": "./tsconfig.json",
	"include": ["vite.config.ts", "react-router.config.ts", "playwright.config.ts", "app/data/pages.ts", "app/lib/articles-fs.ts", "app/lib/plain/remarkPlain.ts", "app/lib/plain/types.ts"],
	"compilerOptions": {
		"composite": true,
		"strict": true,
		"types": ["node"],
		"resolveJsonModule": true,
		"lib": ["ES2022"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"baseUrl": ".",
		"paths": { "@/*": ["./app/*"] }
	}
}
