{
	"name": "executar-monorepo",
	"description": "Monorepo do ecossistema EXECUTAR. Cada produto vive em apps/*; código compartilhado em packages/*.",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev -w apps/blog",
		"build": "npm run build --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"deploy:blog": "npm run deploy -w apps/blog"
	}
}
